(define (problem LIBERO_Industry_Workbench_Ablation)
  (:domain robosuite)
  (:language test routed predicate poses)
    (:regions
      (ghost_init_region
          (:target industry_workbench)
          (:ranges (
              (-0.01 -0.01 0.01 0.01)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (dummy_region
          (:target industry_workbench)
          (:ranges (
              (-0.5 -0.2 -0.09999999999999998 0.2)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    cream_jar_upright_1 cream_jar_upright_2 cream_jar_upright_3 cream_jar_upright_4 - cream_jar_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init_region)
    (LoadSlot conveyor_ghost_1 cream_jar_v_groove x pulse 0.05)
    (On cream_jar_upright_1 industry_workbench_dummy_region)
    (On cream_jar_upright_2 industry_workbench_dummy_region)
    (On cream_jar_upright_3 industry_workbench_dummy_region)
    (On cream_jar_upright_4 industry_workbench_dummy_region)
  )

  (:goal
    (And (Routed cream_jar_upright_1 conveyor_ghost_1) (Routed cream_jar_upright_2 conveyor_ghost_1) (Routed cream_jar_upright_3 conveyor_ghost_1) (Routed cream_jar_upright_4 conveyor_ghost_1))
  )

)
