<mujoco model="cream_bottle">
  <default>
    <default class="visual">
      <geom group="1" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="0" type="mesh"/>
    </default>
  </default>
  
  <asset>
    <material name="mat_body" rgba="0.6 0.85 0.95 1.0" specular="0.3" shininess="0.3"/>
    <mesh name="mesh_body" file="body.obj"/>
    <material name="mat_head" rgba="1.0 1.0 1.0 1.0" specular="0.3" shininess="0.3"/>
    <mesh name="mesh_head" file="head.obj"/>
  </asset>
  
  <worldbody>
    <body>
      <body name="object" pos="0 0 0" quat="1 0 0 0">
        <inertial pos="0 0 0" mass="0.2" diaginertia="1e-3 1e-3 1e-3" />
        
                <geom material="mat_body" mesh="mesh_body" class="visual"/>
        <geom material="mat_head" mesh="mesh_head" class="visual"/>

                <geom mesh="mesh_body" class="collision"/>
        <geom mesh="mesh_head" class="collision"/>
      </body>
      
      <site rgba="0 0 0 0" size="0.01" pos="0 0 -0.0522" quat="1 0 0 0" name="bottom_site"/>        
      <site rgba="0 0 0 0" size="0.01" pos="0 0 0.0459" quat="1 0 0 0" name="top_site"/>   
      <site rgba="0 0 0 0" size="0.01" pos="0.0210 0 0" quat="1 0 0 0" name="horizontal_radius_site"/>
    </body>
  </worldbody>
</mujoco>
