<mujoco model="shoes_inlay">
  <default>
    <default class="visual">
      <geom group="1" type="mesh" contype="0" conaffinity="0" rgba="0.7 0.7 0.7 0.5"/>
    </default>
    <default class="collision">
      <geom group="0" type="mesh" friction="1.0 0.005 0.0001"/>
    </default>
  </default>
  
  <asset>
    <mesh name="model" file="model.obj"/>

  </asset>
  
  <worldbody>
    <body>
      <body name="object" pos="0 0 0" quat="1 0 0 0">
        <inertial pos="0 0 0" mass="0.8" diaginertia="1e-3 1e-3 1e-3" />
        <geom mesh="model" class="visual"/>
        <geom mesh="model" class="collision"/>
      </body>
      
      <site rgba="0 0 0 0" size="0.01" pos="0 0 -0.01000" quat="1 0 0 0" name="bottom_site"/>        
      <site rgba="0 0 0 0" size="0.01" pos="0 0 0.01000" quat="1 0 0 0" name="top_site"/>   
      <site rgba="0 0 0 0" size="0.01" pos="0.05000 0 0" quat="1 0 0 0" name="horizontal_radius_site"/>
      
      <site name="goal_region" type="box" size="0.01 0.01 0.002" quat="1 0 0 0" pos="0 0 0" rgba="0 1 0 0.3" group="0"/>
      
    </body>
  </worldbody>
</mujoco>
