(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language put all objects from the conveyor into the moving tray)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.12885372854431065 0.28781130545127365 -0.10885372854431065 0.30781130545127366)
            )
          )
          (:yaw_rotation (
              (1.5707963267948966 1.5707963267948966)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.006146271455689344 0.03781130545127368 0.026146271455689346 0.057811305451273685)
            )
          )
          (:yaw_rotation (
              (1.5707963267948966 1.5707963267948966)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_1
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_2
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_3
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_4
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_1
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_2
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_3
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (offset_bowl_d2d_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_d2d_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_d2d_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_d2d_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_d2d_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_d2d_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    mouse_naga_upright_1 - mouse_naga_upright
    mouse_black_taipan_upright_1 - mouse_black_taipan_upright
    headset_upright_1 - headset_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0408 steady takt_5.0 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 electronics_tray y pulse 0.0408 service_1.5)
    (On mouse_naga_upright_1 conveyor_belt_1_offset_region_1)
    (On mouse_black_taipan_upright_1 conveyor_belt_1_offset_region_2)
    (On headset_upright_1 conveyor_belt_1_offset_region_3)
  )

  (:goal
    (And (DynamicOn mouse_naga_upright_1 conveyor_ghost_1) (DynamicOn mouse_black_taipan_upright_1 conveyor_ghost_1) (DynamicOn headset_upright_1 conveyor_ghost_1))
  )

