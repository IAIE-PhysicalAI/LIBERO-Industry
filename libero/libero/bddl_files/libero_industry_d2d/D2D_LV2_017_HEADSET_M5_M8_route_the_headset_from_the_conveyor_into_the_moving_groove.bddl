  (:objects
    mouse_naga_upright_1 - mouse_naga_upright
    mouse_white_taipan_upright_1 - mouse_white_taipan_upright
    headset_upright_1 headset_upright_2 - headset_upright
  )

  (:obj_of_interest
    headset_upright_1
    headset_upright_2
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 -0.0419 steady takt_6.0 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 headset_upright_groove x pulse -0.0684 service_2.0)
    (On mouse_naga_upright_1 conveyor_belt_1_tail_region_2)
    (On mouse_white_taipan_upright_1 conveyor_belt_1_tail_region_4)
    (On headset_upright_1 conveyor_belt_1_tail_region_1)
    (On headset_upright_2 conveyor_belt_1_tail_region_3)
  )

  (:goal
    (And (Routed headset_upright_1 conveyor_ghost_1) (Routed headset_upright_2 conveyor_ghost_1))
  )

