    (AtSpeed conveyor_belt_1 0.0337 steady takt_5.0 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_naga_upright_groove y pulse 0.0757 service_2.0)
    (On mouse_naga_upright_1 conveyor_belt_1_offset_region_1)
    (On mouse_naga_upright_2 conveyor_belt_1_offset_region_3)
    (On mouse_naga_upright_3 conveyor_belt_1_offset_region_2)
    (On headset_upright_1 conveyor_belt_1_offset_region_4)
  )

  (:goal
