    (AtSpeed conveyor_belt_1 -0.036 steady takt_5.0 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_white_taipan_upright_groove y pulse -0.046 service_2.0)
