    (AtSpeed conveyor_belt_1 -0.0595 steady takt_6.0 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_black_taipan_upright_inlay x pulse 0.074 service_2.5)
