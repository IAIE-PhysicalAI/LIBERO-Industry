(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.0217543336100475 0.05641119192054871 0.0217563336100475 0.056413191920548715)
            )
          )
          (:yaw_rotation (
              (0.11873850889667657 0.11873850889667657)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21002332938518722 0.028760186541167056 -0.21002132938518722 0.028762186541167058)
            )
          )
          (:yaw_rotation (
              (-0.13815295556375617 -0.13815295556375617)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_flat_1 cream_jar_flat_2 cream_jar_flat_3 - cream_jar_flat
    cream_bottle_flat_1 - cream_bottle_flat
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_flat_groove y pulse 0.05 service_3.0)
    (On cream_jar_flat_1 grey_plate_1_place_region_6)
    (On cream_jar_flat_2 grey_plate_1_place_region_5)
    (On cream_jar_flat_3 grey_plate_1_place_region_2)
    (On cream_bottle_flat_1 grey_plate_1_place_region_3)
    (On cream_bottle_upright_1 grey_plate_1_place_region_4)
  )

  (:goal
    (And (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_flat_2 conveyor_ghost_1) (Routed cream_jar_flat_3 conveyor_ghost_1))
  )

)
