(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.020928365734321004 0.04098739655993612 0.020930365734321006 0.04098939655993612)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21342192269112306 0.04098739655993612 -0.21341992269112306 0.04098939655993612)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_flat_1 pump_bottle_flat_2 pump_bottle_flat_3 - pump_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse 0.08 service_3.5)
    (On pump_bottle_flat_1 grey_plate_1_place_region_2)
    (On pump_bottle_flat_2 grey_plate_1_place_region_4)
    (On pump_bottle_flat_3 grey_plate_1_place_region_3)
  )

  (:goal
    (And (DynamicOn pump_bottle_flat_1 conveyor_ghost_1) (DynamicOn pump_bottle_flat_2 conveyor_ghost_1) (DynamicOn pump_bottle_flat_3 conveyor_ghost_1))
  )

)
