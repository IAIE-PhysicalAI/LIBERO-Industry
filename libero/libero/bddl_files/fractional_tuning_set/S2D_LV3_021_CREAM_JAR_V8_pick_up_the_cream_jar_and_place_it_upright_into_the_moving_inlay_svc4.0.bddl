(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.03314610803778241 -0.003076260824620667 0.03314810803778241 -0.0030742608246206666)
            )
          )
          (:yaw_rotation (
              (3.2934800522571894 3.2934800522571894)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.18944770831225052 -0.03714786858806515 -0.18944570831225052 -0.03714586858806515)
            )
          )
          (:yaw_rotation (
              (3.3779184487143716 3.3779184487143716)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_upright_1 cream_jar_upright_2 cream_jar_upright_3 cream_jar_upright_4 - cream_jar_upright
    cream_bottle_flat_1 - cream_bottle_flat
    serum_bottle_upright_1 - serum_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_upright_inlay y pulse 0.08 service_4.0)
    (On cream_jar_upright_1 grey_plate_1_place_region_3)
    (On cream_jar_upright_2 grey_plate_1_place_region_5)
    (On cream_jar_upright_3 grey_plate_1_place_region_2)
    (On cream_bottle_flat_1 grey_plate_1_place_region_6)
    (On serum_bottle_upright_1 grey_plate_1_place_region_1)
    (On cream_jar_upright_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_jar_upright_1 conveyor_ghost_1) (Routed cream_jar_upright_2 conveyor_ghost_1) (Routed cream_jar_upright_3 conveyor_ghost_1) (Routed cream_jar_upright_4 conveyor_ghost_1))
  )

)
