(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.04761370296854789 -0.0175501193280196 0.04761570296854789 -0.0175481193280196)
            )
          )
          (:yaw_rotation (
              (3.2950091470179084 3.2950091470179084)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.16279316008195752 -0.0500856627917939 -0.16279116008195751 -0.050083662791793895)
            )
          )
          (:yaw_rotation (
              (3.2817824000712146 3.2817824000712146)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_upright_1 cream_jar_upright_2 cream_jar_upright_3 - cream_jar_upright
    cream_jar_flat_1 - cream_jar_flat
    serum_bottle_upright_1 - serum_bottle_upright
    serum_bottle_flat_1 - serum_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_upright_inlay y pulse 0.03 service_3.5)
    (On cream_jar_upright_1 grey_plate_1_place_region_3)
    (On cream_jar_upright_2 grey_plate_1_place_region_1)
    (On cream_jar_flat_1 grey_plate_1_place_region_2)
    (On serum_bottle_upright_1 grey_plate_1_place_region_5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_6)
    (On cream_jar_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_jar_upright_1 conveyor_ghost_1) (Routed cream_jar_upright_2 conveyor_ghost_1) (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_upright_3 conveyor_ghost_1))
  )

)
