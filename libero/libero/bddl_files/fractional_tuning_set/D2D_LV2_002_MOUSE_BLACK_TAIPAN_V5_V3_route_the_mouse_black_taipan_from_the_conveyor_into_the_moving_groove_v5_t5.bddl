(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route targets)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.13268632577638978 0.3951747458787676 -0.11268632577638978 0.4151747458787676)
            )
          )
          (:yaw_rotation (
              (1.4449414593558647 1.4449414593558647)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.022313674223610226 -0.18385783328189123 0.04231367422361023 -0.1638578332818912)
            )
          )
          (:yaw_rotation (
              (1.4449414593558647 1.4449414593558647)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    mouse_black_taipan_upright_1 mouse_black_taipan_upright_2 mouse_black_taipan_upright_3 - mouse_black_taipan_upright
    headset_upright_1 - headset_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0533 steady takt_5 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_black_taipan_v_groove y pulse 0.0283 service_2.0)
    (On mouse_black_taipan_upright_1 conveyor_belt_1_offset_region_3)
    (On headset_upright_1 conveyor_belt_1_offset_region_2)
    (On mouse_black_taipan_upright_2 conveyor_belt_1_offset_region_1)
    (On mouse_black_taipan_upright_3 conveyor_belt_1_offset_region_4)
  )

  (:goal
    (And (Routed mouse_black_taipan_upright_1 conveyor_ghost_1) (Routed mouse_black_taipan_upright_2 conveyor_ghost_1) (Routed mouse_black_taipan_upright_3 conveyor_ghost_1))
  )

)
