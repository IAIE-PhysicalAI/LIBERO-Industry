(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.009419383665384412 0.03939937719662738 0.009421383665384411 0.03940137719662738)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.22493090476005964 0.03939937719662738 -0.22492890476005964 0.03940137719662738)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_flat_1 cream_jar_flat_2 cream_jar_flat_3 - cream_jar_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse 0.08 service_2.0)
    (On cream_jar_flat_1 grey_plate_1_place_region_2)
    (On cream_jar_flat_2 grey_plate_1_place_region_3)
    (On cream_jar_flat_3 grey_plate_1_place_region_4)
  )

  (:goal
    (And (DynamicOn cream_jar_flat_1 conveyor_ghost_1) (DynamicOn cream_jar_flat_2 conveyor_ghost_1) (DynamicOn cream_jar_flat_3 conveyor_ghost_1))
  )

)
