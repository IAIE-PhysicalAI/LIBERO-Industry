(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.036970934793103094 -0.01449836813537413 0.036972934793103096 -0.014496368135374131)
            )
          )
          (:yaw_rotation (
              (0.11795055484756335 0.11795055484756335)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.16999373017349692 -0.03902380618716458 -0.16999173017349692 -0.039021806187164575)
            )
          )
          (:yaw_rotation (
              (-0.039980223975092787 -0.039980223975092787)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_upright_1 serum_bottle_upright_2 serum_bottle_upright_3 - serum_bottle_upright
    cream_bottle_flat_1 - cream_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_groove y pulse 0.03 service_3.5)
    (On serum_bottle_upright_1 grey_plate_1_place_region_6)
    (On serum_bottle_upright_2 grey_plate_1_place_region_4)
    (On serum_bottle_upright_3 grey_plate_1_place_region_5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_2)
  )

  (:goal
    (And (Routed serum_bottle_upright_1 conveyor_ghost_1) (Routed serum_bottle_upright_2 conveyor_ghost_1) (Routed serum_bottle_upright_3 conveyor_ghost_1))
  )

)
