(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.006716249770949209 0.01570158236683107 0.006718249770949209 0.015703582366831073)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.22763403865449486 0.01570158236683107 -0.22763203865449486 0.015703582366831073)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_flat_1 pump_bottle_flat_2 pump_bottle_flat_3 - pump_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse 0.03 service_2.5)
    (On pump_bottle_flat_1 grey_plate_1_place_region_1)
    (On pump_bottle_flat_2 grey_plate_1_place_region_3)
    (On pump_bottle_flat_3 grey_plate_1_place_region_6)
  )

  (:goal
    (And (DynamicOn pump_bottle_flat_1 conveyor_ghost_1) (DynamicOn pump_bottle_flat_2 conveyor_ghost_1) (DynamicOn pump_bottle_flat_3 conveyor_ghost_1))
  )

)
