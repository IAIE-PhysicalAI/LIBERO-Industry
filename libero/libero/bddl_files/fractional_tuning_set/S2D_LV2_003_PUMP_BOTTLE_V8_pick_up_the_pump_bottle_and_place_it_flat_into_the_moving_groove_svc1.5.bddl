(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.013566365820540943 -0.005000602753045811 -0.013564365820540944 -0.004998602753045811)
            )
          )
          (:yaw_rotation (
              (-0.08350187469418001 -0.08350187469418001)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.20004704251284514 0.010607175624789427 -0.20004504251284513 0.010609175624789425)
            )
          )
          (:yaw_rotation (
              (-0.09737526448295496 -0.09737526448295496)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 - pump_bottle_upright
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_flat_groove y pulse 0.08 service_1.5)
    (On pump_bottle_upright_1 grey_plate_1_place_region_4)
    (On pump_bottle_upright_2 grey_plate_1_place_region_1)
    (On pump_bottle_upright_3 grey_plate_1_place_region_5)
    (On cream_bottle_upright_1 grey_plate_1_place_region_6)
  )

  (:goal
    (And (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1) (Routed pump_bottle_upright_3 conveyor_ghost_1))
  )

)
