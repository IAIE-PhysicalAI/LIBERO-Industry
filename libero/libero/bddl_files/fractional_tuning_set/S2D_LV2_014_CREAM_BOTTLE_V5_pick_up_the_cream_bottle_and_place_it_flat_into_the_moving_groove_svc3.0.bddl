(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.020339700762336738 -0.034118389150284624 -0.020337700762336736 -0.03411638915028462)
            )
          )
          (:yaw_rotation (
              (-0.06721203901577408 -0.06721203901577408)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.24471930790544902 -0.01901462785143805 -0.24471730790544902 -0.01901262785143805)
            )
          )
          (:yaw_rotation (
              (0.14735972250883653 0.14735972250883653)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_upright_1 cream_bottle_upright_2 cream_bottle_upright_3 - cream_bottle_upright
    cream_jar_flat_1 - cream_jar_flat
    pump_bottle_upright_1 - pump_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_groove y pulse 0.05 service_3.0)
    (On cream_bottle_upright_1 grey_plate_1_place_region_4)
    (On cream_bottle_upright_2 grey_plate_1_place_region_3)
    (On cream_bottle_upright_3 grey_plate_1_place_region_2)
    (On cream_jar_flat_1 grey_plate_1_place_region_5)
    (On pump_bottle_upright_1 grey_plate_1_place_region_1)
  )

  (:goal
    (And (Routed cream_bottle_upright_1 conveyor_ghost_1) (Routed cream_bottle_upright_2 conveyor_ghost_1) (Routed cream_bottle_upright_3 conveyor_ghost_1))
  )

)
