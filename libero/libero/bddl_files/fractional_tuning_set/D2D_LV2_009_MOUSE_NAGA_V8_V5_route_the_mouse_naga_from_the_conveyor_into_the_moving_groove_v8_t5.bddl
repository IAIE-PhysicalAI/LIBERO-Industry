(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route targets)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.11973020793114579 0.37959682563805863 -0.0997302079311458 0.39959682563805865)
            )
          )
          (:yaw_rotation (
              (1.5495711777073335 1.5495711777073335)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.03526979206885421 -0.18568779578988706 0.05526979206885421 -0.16568779578988704)
            )
          )
          (:yaw_rotation (
              (1.5495711777073335 1.5495711777073335)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    mouse_naga_upright_1 mouse_naga_upright_2 - mouse_naga_upright
    headset_upright_1 - headset_upright
    mouse_white_taipan_upright_1 - mouse_white_taipan_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0767 steady takt_5 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_naga_upright_groove y pulse 0.0508 service_2.0)
    (On mouse_naga_upright_1 conveyor_belt_1_offset_region_1)
    (On mouse_naga_upright_2 conveyor_belt_1_offset_region_2)
    (On headset_upright_1 conveyor_belt_1_offset_region_3)
    (On mouse_white_taipan_upright_1 conveyor_belt_1_offset_region_4)
  )

  (:goal
    (And (Routed mouse_naga_upright_1 conveyor_ghost_1) (Routed mouse_naga_upright_2 conveyor_ghost_1))
  )

)
