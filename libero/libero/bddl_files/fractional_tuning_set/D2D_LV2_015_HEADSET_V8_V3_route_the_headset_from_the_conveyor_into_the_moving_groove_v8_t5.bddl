(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route targets)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.1124556504109283 0.4115779319215226 -0.0924556504109283 0.4315779319215226)
            )
          )
          (:yaw_rotation (
              (1.4133625301571238 1.4133625301571238)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.042544349589071696 -0.17274909621618412 0.0625443495890717 -0.1527490962161841)
            )
          )
          (:yaw_rotation (
              (1.4133625301571238 1.4133625301571238)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    headset_upright_1 headset_upright_2 headset_upright_3 - headset_upright
    mouse_black_taipan_upright_1 - mouse_black_taipan_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0763 steady takt_5 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 headset_v_groove x pulse 0.0292 service_2.0)
    (On headset_upright_1 conveyor_belt_1_offset_region_2)
    (On headset_upright_2 conveyor_belt_1_offset_region_1)
    (On headset_upright_3 conveyor_belt_1_offset_region_3)
    (On mouse_black_taipan_upright_1 conveyor_belt_1_offset_region_4)
  )

  (:goal
    (And (Routed headset_upright_1 conveyor_ghost_1) (Routed headset_upright_2 conveyor_ghost_1) (Routed headset_upright_3 conveyor_ghost_1))
  )

)
