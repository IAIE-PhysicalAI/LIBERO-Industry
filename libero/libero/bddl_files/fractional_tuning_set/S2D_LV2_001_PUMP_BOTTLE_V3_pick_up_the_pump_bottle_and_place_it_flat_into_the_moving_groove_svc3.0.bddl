(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.03834606810709039 0.0023942261912524255 0.03834806810709039 0.002396226191252426)
            )
          )
          (:yaw_rotation (
              (-0.0967470859825604 -0.0967470859825604)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.1714536208213215 0.022755300955125964 -0.1714516208213215 0.022757300955125966)
            )
          )
          (:yaw_rotation (
              (0.059192406333800456 0.059192406333800456)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 - pump_bottle_upright
    cream_jar_flat_1 - cream_jar_flat
    cream_bottle_flat_1 - cream_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_flat_groove y pulse 0.03 service_3.0)
    (On pump_bottle_upright_1 grey_plate_1_place_region_2)
    (On pump_bottle_upright_2 grey_plate_1_place_region_1)
    (On pump_bottle_upright_3 grey_plate_1_place_region_3)
    (On cream_jar_flat_1 grey_plate_1_place_region_5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_6)
  )

  (:goal
    (And (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1) (Routed pump_bottle_upright_3 conveyor_ghost_1))
  )

)
