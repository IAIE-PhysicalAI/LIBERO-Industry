(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.023235648218895302 -0.004605012520842318 0.023237648218895304 -0.004603012520842318)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21111464020654877 -0.004605012520842318 -0.21111264020654877 -0.004603012520842318)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_flat_1 pump_bottle_flat_2 pump_bottle_flat_3 - pump_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse 0.05 service_2.0)
    (On pump_bottle_flat_1 grey_plate_1_place_region_5)
    (On pump_bottle_flat_2 grey_plate_1_place_region_4)
    (On pump_bottle_flat_3 grey_plate_1_place_region_6)
  )

  (:goal
    (And (DynamicOn pump_bottle_flat_1 conveyor_ghost_1) (DynamicOn pump_bottle_flat_2 conveyor_ghost_1) (DynamicOn pump_bottle_flat_3 conveyor_ghost_1))
  )

)
