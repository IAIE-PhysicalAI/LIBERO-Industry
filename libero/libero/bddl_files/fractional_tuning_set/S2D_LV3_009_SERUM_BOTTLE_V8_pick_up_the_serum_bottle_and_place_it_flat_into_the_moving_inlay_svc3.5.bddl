(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.11268136052683757 -0.11535122097177888 -0.11267936052683757 -0.11534922097177888)
            )
          )
          (:yaw_rotation (
              (4.860196232707081 4.860196232707081)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.14659277328941447 0.11240552150680377 -0.14659077328941447 0.11240752150680378)
            )
          )
          (:yaw_rotation (
              (5.037884455615717 5.037884455615717)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 serum_bottle_flat_4 - serum_bottle_flat
    serum_bottle_upright_1 - serum_bottle_upright
    cream_jar_upright_1 - cream_jar_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_inlay y pulse 0.08 service_3.5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_6)
    (On serum_bottle_flat_2 grey_plate_1_place_region_1)
    (On serum_bottle_upright_1 grey_plate_1_place_region_4)
    (On cream_jar_upright_1 grey_plate_1_place_region_2)
    (On serum_bottle_flat_3 conveyor_ghost_1)
    (On serum_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_upright_1 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1) (Routed serum_bottle_flat_4 conveyor_ghost_1))
  )

)
