(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route targets)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.09709980467715705 -0.4422007793573838 -0.07709980467715706 -0.42220077935738376)
            )
          )
          (:yaw_rotation (
              (1.624509058547668 1.624509058547668)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.14209980467715708 -0.04220077935738376 -0.12209980467715707 -0.02220077935738376)
            )
          )
          (:yaw_rotation (
              (1.624509058547668 1.624509058547668)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    mouse_naga_upright_4 mouse_naga_upright_1 mouse_naga_upright_2 mouse_naga_upright_3 - mouse_naga_upright    mouse_black_taipan_upright_1 - mouse_black_taipan_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0356 steady takt_5 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_naga_upright_inlay x pulse -0.0623 service_2.5)
    (On mouse_naga_upright_4 conveyor_belt_1_offset_region_2)
    (On mouse_naga_upright_1 conveyor_belt_1_offset_region_3)
    (On mouse_black_taipan_upright_1 conveyor_belt_1_offset_region_4)
    (On mouse_naga_upright_2 conveyor_ghost_1)
    (On mouse_naga_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed mouse_naga_upright_4 conveyor_ghost_1) (Routed mouse_naga_upright_1 conveyor_ghost_1) (Routed mouse_naga_upright_2 conveyor_ghost_1) (Routed mouse_naga_upright_3 conveyor_ghost_1))
  )

)
