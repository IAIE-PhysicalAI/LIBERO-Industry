(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.04683121097125384 -0.029613616989681422 0.04683321097125384 -0.02961161698968142)
            )
          )
          (:yaw_rotation (
              (-0.34365081288510435 -0.34365081288510435)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2021761569786998 0.05949363133517487 -0.2021741569786998 0.059495631335174874)
            )
          )
          (:yaw_rotation (
              (0.016866217522811144 0.016866217522811144)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 pump_bottle_upright_4 pump_bottle_upright_5 - pump_bottle_upright
    cream_jar_upright_1 - cream_jar_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_upright_inlay y pulse 0.08 service_3.0)
    (On pump_bottle_upright_4 grey_plate_1_place_region_6)
    (On pump_bottle_upright_5 grey_plate_1_place_region_1)
    (On pump_bottle_upright_1 grey_plate_1_place_region_2)
    (On cream_jar_upright_1 grey_plate_1_place_region_5)
    (On pump_bottle_upright_2 conveyor_ghost_1)
    (On pump_bottle_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed pump_bottle_upright_4 conveyor_ghost_1) (Routed pump_bottle_upright_5 conveyor_ghost_1) (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1) (Routed pump_bottle_upright_3 conveyor_ghost_1))
  )

)
