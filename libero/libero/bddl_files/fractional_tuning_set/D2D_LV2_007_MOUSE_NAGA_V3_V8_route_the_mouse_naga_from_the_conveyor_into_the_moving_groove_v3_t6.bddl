(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route targets)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.13091122158052215 0.3822180536225387 -0.11091122158052216 0.4022180536225387)
            )
          )
          (:yaw_rotation (
              (1.6066479461457521 1.6066479461457521)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.02408877841947784 -0.18803266676620894 0.04408877841947784 -0.16803266676620893)
            )
          )
          (:yaw_rotation (
              (1.6066479461457521 1.6066479461457521)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    mouse_naga_upright_1 mouse_naga_upright_2 mouse_naga_upright_3 - mouse_naga_upright
    headset_upright_1 - headset_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0287 steady takt_6 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_naga_upright_groove y pulse 0.0768 service_2.0)
    (On mouse_naga_upright_1 conveyor_belt_1_offset_region_1)
    (On mouse_naga_upright_2 conveyor_belt_1_offset_region_3)
    (On mouse_naga_upright_3 conveyor_belt_1_offset_region_2)
    (On headset_upright_1 conveyor_belt_1_offset_region_4)
  )

  (:goal
    (And (Routed mouse_naga_upright_1 conveyor_ghost_1) (Routed mouse_naga_upright_2 conveyor_ghost_1) (Routed mouse_naga_upright_3 conveyor_ghost_1))
  )

)
