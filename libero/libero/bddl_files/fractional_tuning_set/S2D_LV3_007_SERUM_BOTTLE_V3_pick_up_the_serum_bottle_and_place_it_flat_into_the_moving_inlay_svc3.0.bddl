(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.10952428879046842 -0.10924994592201637 -0.10952228879046842 -0.10924794592201637)
            )
          )
          (:yaw_rotation (
              (1.8592307191052024 1.8592307191052024)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.1877588435206101 0.1544248054082334 -0.1877568435206101 0.1544268054082334)
            )
          )
          (:yaw_rotation (
              (1.277627881292236 1.277627881292236)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_upright_1 serum_bottle_upright_2 serum_bottle_upright_3 - serum_bottle_upright
    cream_bottle_upright_1 - cream_bottle_upright
    serum_bottle_flat_1 serum_bottle_flat_2 - serum_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_inlay y pulse 0.03 service_3.0)
    (On serum_bottle_upright_1 grey_plate_1_place_region_6)
    (On serum_bottle_upright_2 grey_plate_1_place_region_4)
    (On serum_bottle_upright_3 grey_plate_1_place_region_1)
    (On cream_bottle_upright_1 grey_plate_1_place_region_3)
    (On serum_bottle_flat_1 conveyor_ghost_1)
    (On serum_bottle_flat_2 conveyor_ghost_1)
  )

  (:goal
    (And (Routed serum_bottle_upright_1 conveyor_ghost_1) (Routed serum_bottle_upright_2 conveyor_ghost_1) (Routed serum_bottle_upright_3 conveyor_ghost_1) (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1))
  )

)
