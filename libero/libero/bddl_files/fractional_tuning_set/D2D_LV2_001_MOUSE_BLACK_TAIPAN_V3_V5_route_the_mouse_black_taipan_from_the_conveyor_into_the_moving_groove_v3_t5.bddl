(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route targets)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.13144315503429754 0.3891348907622824 -0.11144315503429754 0.40913489076228243)
            )
          )
          (:yaw_rotation (
              (1.690549885865856 1.690549885865856)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.023556844965702463 -0.21967164189281368 0.04355684496570247 -0.19967164189281367)
            )
          )
          (:yaw_rotation (
              (1.690549885865856 1.690549885865856)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    mouse_black_taipan_upright_1 mouse_black_taipan_upright_2 - mouse_black_taipan_upright
    headset_upright_1 - headset_upright
    mouse_naga_upright_1 - mouse_naga_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0319 steady takt_5 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_black_taipan_upright_groove y pulse 0.0543 service_2.0)
    (On mouse_black_taipan_upright_1 conveyor_belt_1_offset_region_1)
    (On mouse_black_taipan_upright_2 conveyor_belt_1_offset_region_2)
    (On headset_upright_1 conveyor_belt_1_offset_region_4)
    (On mouse_naga_upright_1 conveyor_belt_1_offset_region_3)
  )

  (:goal
    (And (Routed mouse_black_taipan_upright_1 conveyor_ghost_1) (Routed mouse_black_taipan_upright_2 conveyor_ghost_1))
  )

)
