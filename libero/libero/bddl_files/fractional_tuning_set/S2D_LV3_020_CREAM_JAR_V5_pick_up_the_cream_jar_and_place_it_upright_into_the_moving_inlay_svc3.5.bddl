(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.09723210364266278 -0.1014303413684186 -0.09723010364266278 -0.10142834136841859)
            )
          )
          (:yaw_rotation (
              (4.885790910294705 4.885790910294705)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.13760103752351113 0.129037180320855 -0.13759903752351113 0.129039180320855)
            )
          )
          (:yaw_rotation (
              (5.024433399539558 5.024433399539558)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_flat_1 - cream_jar_flat
    cream_jar_upright_1 cream_jar_upright_2 cream_jar_upright_3 - cream_jar_upright
    serum_bottle_upright_1 - serum_bottle_upright
    pump_bottle_flat_1 - pump_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_upright_inlay y pulse 0.05 service_3.5)
    (On cream_jar_flat_1 grey_plate_1_place_region_5)
    (On cream_jar_upright_1 grey_plate_1_place_region_1)
    (On cream_jar_upright_2 grey_plate_1_place_region_4)
    (On serum_bottle_upright_1 grey_plate_1_place_region_3)
    (On pump_bottle_flat_1 grey_plate_1_place_region_2)
    (On cream_jar_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_upright_1 conveyor_ghost_1) (Routed cream_jar_upright_2 conveyor_ghost_1) (Routed cream_jar_upright_3 conveyor_ghost_1))
  )

)
