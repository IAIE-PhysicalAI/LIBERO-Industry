(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route targets)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.11947687275709241 0.3989905635022998 -0.09947687275709242 0.4189905635022998)
            )
          )
          (:yaw_rotation (
              (1.478062321251811 1.478062321251811)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.03552312724290758 -0.16047393376392177 0.05552312724290758 -0.14047393376392175)
            )
          )
          (:yaw_rotation (
              (1.478062321251811 1.478062321251811)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    mouse_naga_upright_1 mouse_naga_upright_2 mouse_naga_upright_3 - mouse_naga_upright
    mouse_white_taipan_upright_1 - mouse_white_taipan_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0478 steady takt_5 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 mouse_naga_upright_groove x pulse 0.0264 service_2.0)
    (On mouse_naga_upright_1 conveyor_belt_1_offset_region_4)
    (On mouse_naga_upright_2 conveyor_belt_1_offset_region_2)
    (On mouse_white_taipan_upright_1 conveyor_belt_1_offset_region_3)
    (On mouse_naga_upright_3 conveyor_belt_1_offset_region_1)
  )

  (:goal
    (And (Routed mouse_naga_upright_1 conveyor_ghost_1) (Routed mouse_naga_upright_2 conveyor_ghost_1) (Routed mouse_naga_upright_3 conveyor_ghost_1))
  )

)
