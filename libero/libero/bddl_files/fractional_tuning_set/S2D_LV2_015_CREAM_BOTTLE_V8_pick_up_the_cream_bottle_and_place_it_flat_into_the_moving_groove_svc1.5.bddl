(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.011637338863199937 -0.03923820748591608 -0.011635338863199939 -0.03923620748591608)
            )
          )
          (:yaw_rotation (
              (0.10479161963118203 0.10479161963118203)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2110764338074311 -0.060214592075451295 -0.2110744338074311 -0.06021259207545129)
            )
          )
          (:yaw_rotation (
              (0.16488287140999505 0.16488287140999505)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_upright_1 cream_bottle_upright_2 cream_bottle_upright_3 - cream_bottle_upright
    pump_bottle_flat_1 - pump_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_groove y pulse 0.08 service_1.5)
    (On cream_bottle_upright_1 grey_plate_1_place_region_5)
    (On cream_bottle_upright_2 grey_plate_1_place_region_2)
    (On cream_bottle_upright_3 grey_plate_1_place_region_4)
    (On pump_bottle_flat_1 grey_plate_1_place_region_3)
  )

  (:goal
    (And (Routed cream_bottle_upright_1 conveyor_ghost_1) (Routed cream_bottle_upright_2 conveyor_ghost_1) (Routed cream_bottle_upright_3 conveyor_ghost_1))
  )

)
