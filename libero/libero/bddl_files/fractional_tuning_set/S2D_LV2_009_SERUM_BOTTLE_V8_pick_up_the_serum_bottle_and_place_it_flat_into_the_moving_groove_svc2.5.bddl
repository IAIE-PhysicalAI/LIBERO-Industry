(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.01957458502910915 0.007579475557627303 -0.01957258502910915 0.0075814755576273036)
            )
          )
          (:yaw_rotation (
              (0.012079723938429633 0.012079723938429633)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.22045498915799885 0.005152777695595931 -0.22045298915799885 0.005154777695595932)
            )
          )
          (:yaw_rotation (
              (-0.09836084743994786 -0.09836084743994786)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_upright_1 serum_bottle_upright_2 serum_bottle_upright_3 - serum_bottle_upright
    cream_bottle_flat_1 - cream_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_groove y pulse 0.08 service_2.5)
    (On serum_bottle_upright_1 grey_plate_1_place_region_3)
    (On serum_bottle_upright_2 grey_plate_1_place_region_2)
    (On serum_bottle_upright_3 grey_plate_1_place_region_4)
    (On cream_bottle_flat_1 grey_plate_1_place_region_6)
  )

  (:goal
    (And (Routed serum_bottle_upright_1 conveyor_ghost_1) (Routed serum_bottle_upright_2 conveyor_ghost_1) (Routed serum_bottle_upright_3 conveyor_ghost_1))
  )

)
