(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.012516681916765705 0.024894982238753832 -0.012514681916765706 0.024896982238753834)
            )
          )
          (:yaw_rotation (
              (-0.028833112374652553 -0.028833112374652553)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21962915945707437 0.030868334981970197 -0.21962715945707437 0.0308703349819702)
            )
          )
          (:yaw_rotation (
              (-0.16185731115316596 -0.16185731115316596)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 - pump_bottle_upright
    cream_jar_flat_1 - cream_jar_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_flat_groove y pulse 0.05 service_4.0)
    (On pump_bottle_upright_1 grey_plate_1_place_region_3)
    (On pump_bottle_upright_2 grey_plate_1_place_region_4)
    (On pump_bottle_upright_3 grey_plate_1_place_region_5)
    (On cream_jar_flat_1 grey_plate_1_place_region_1)
  )

  (:goal
    (And (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1) (Routed pump_bottle_upright_3 conveyor_ghost_1))
  )

)
