(define (problem LIBERO_Industry_Workbench_Ablation)
  (:domain robosuite)
  (:language put the akita black bowl to the tray)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.023235648218895302 -0.004605012520842318 0.023237648218895304 -0.004603012520842318)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21111464020654877 -0.004605012520842318 -0.21111264020654877 -0.004603012520842318)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    ablation_akita_black_bowl_1 - ablation_akita_black_bowl
  )


  (:obj_of_interest
