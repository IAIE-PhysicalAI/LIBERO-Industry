    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse 0.0 service_1.5)
    (On ablation_akita_black_bowl_1 grey_plate_1_place_region_5)
  )


  (:goal
