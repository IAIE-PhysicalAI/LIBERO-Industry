(define (problem LIBERO_Industry_Workbench_Ablation)
  (:domain robosuite)
  (:language put the akita black bowl from the conveyor into the tray)
    (:regions
      (belt_init
          (:target industry_workbench)
          (:ranges (
              (-0.1268023148294173 0.2784730240817992 -0.10680231482941731 0.2984730240817992)
            )
          )
          (:yaw_rotation (
              (1.5707963267948966 1.5707963267948966)
            )
          )
      )
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.028197685170582694 -0.1715269759182008 0.0481976851705827 -0.15152697591820077)
            )
          )
          (:yaw_rotation (
              (1.5707963267948966 1.5707963267948966)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_bowl_1
          (:target conveyor_belt_1)
      )
      (offset_bowl_2
          (:target conveyor_belt_1)
      )
      (offset_bowl_3
          (:target conveyor_belt_1)
      )
      (tail_bowl_1
          (:target conveyor_belt_1)
      )
      (tail_bowl_2
          (:target conveyor_belt_1)
      )
      (tail_bowl_3
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (centre_region
          (:target conveyor_belt_1)
      )
      (centre_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    ablation_akita_black_bowl_1 - ablation_akita_black_bowl
  )


  (:obj_of_interest
    ablation_akita_black_bowl_1
  )


  (:init
    (On conveyor_belt_1 industry_workbench_belt_init)
    (AtSpeed conveyor_belt_1 0.0 steady takt_4.0 offset_1.5)
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (LoadSlot conveyor_ghost_1 electronics_tray y pulse 0.0 service_1.5)
    (On ablation_akita_black_bowl_1 conveyor_belt_1_ablation_region_d2d)
  )


  (:goal
    (And (DynamicOn ablation_akita_black_bowl_1 conveyor_ghost_1))
  )


)
