(define (problem LIBERO_Industry_Workbench_Ablation)
  (:domain robosuite)
  (:language put all objects from the conveyor into the moving tray)
    (:regions
      (belt_init_region
          (:target industry_workbench)
          (:ranges (
              (0.11 0.1887 0.13 0.20870000000000002)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (ghost_init_region
          (:target industry_workbench)
          (:ranges (
              (0.11 -0.1613 0.13 -0.14129999999999998)
            )
          )
          (:yaw_rotation (
              (1.5707963267948966 1.5707963267948966)
            )
          )
      )
      (contact_region
          (:target conveyor_belt_1)
      )
      (offset_region_1
          (:target conveyor_belt_1)
      )
      (offset_region_2
          (:target conveyor_belt_1)
      )
      (offset_region_3
          (:target conveyor_belt_1)
      )
      (offset_region_4
          (:target conveyor_belt_1)
      )
      (tail_region_1
          (:target conveyor_belt_1)
      )
      (tail_region_2
          (:target conveyor_belt_1)
      )
      (tail_region_3
          (:target conveyor_belt_1)
      )
      (tail_region_4
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_1
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_2
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_3
          (:target conveyor_belt_1)
      )
      (offset_region_d2d_4
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_1
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_2
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_3
          (:target conveyor_belt_1)
      )
      (tail_region_d2d_4
          (:target conveyor_belt_1)
      )
      (ablation_region_d2s
          (:target conveyor_belt_1)
      )
      (ablation_region_d2d
          (:target conveyor_belt_1)
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_belt_1 - conveyor_belt
    conveyor_ghost_1 - conveyor_ghost
  )

  (:objects
    headset_upright_1 - headset_upright
    mouse_white_taipan_upright_1 - mouse_white_taipan_upright
    mouse_black_taipan_upright_1 - mouse_black_taipan_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_belt_1 industry_workbench_belt_init_region)
    (AtSpeed conveyor_belt_1 0.0489 steady)
    (On conveyor_ghost_1 industry_workbench_ghost_init_region)
    (On headset_upright_1 conveyor_belt_1_offset_region_d2d_1)
    (On mouse_white_taipan_upright_1 conveyor_belt_1_offset_region_d2d_4)
    (On mouse_black_taipan_upright_1 conveyor_belt_1_offset_region_d2d_3)
    (LoadSlot conveyor_ghost_1 electronics_tray y pulse 0.0489)
  )

  (:goal
    (And (DynamicOn mouse_white_taipan_upright_1 conveyor_ghost_1))
  )

)
