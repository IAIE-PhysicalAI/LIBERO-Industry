(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language put the cream bottle to the moving tray)
    (:regions
      (ghost_init_region
          (:target industry_workbench)
          (:ranges (
              (0.0454 -0.0238 0.0654 -0.0037999999999999996)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (bottle_init_region
          (:target industry_workbench)
          (:ranges (
              (-0.2546 -0.0238 -0.2346 -0.0037999999999999996)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 - cream_bottle_flat
  )

  (:obj_of_interest
    cream_bottle_flat_1
    cream_bottle_flat_2
    cream_bottle_flat_3
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init_region)
    (On grey_plate_1 industry_workbench_bottle_init_region)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse 0.0767)
    (On cream_bottle_flat_1 grey_plate_1_place_region_2)
    (On cream_bottle_flat_2 grey_plate_1_place_region_1)
    (On cream_bottle_flat_3 grey_plate_1_place_region_5)
  )

  (:goal
    (And (DynamicOn cream_bottle_flat_1 conveyor_ghost_1) (DynamicOn cream_bottle_flat_2 conveyor_ghost_1) (DynamicOn cream_bottle_flat_3 conveyor_ghost_1))
  )

)
