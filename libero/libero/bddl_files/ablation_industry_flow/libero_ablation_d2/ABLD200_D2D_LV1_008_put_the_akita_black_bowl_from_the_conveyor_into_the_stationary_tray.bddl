          (:target industry_workbench)
          (:ranges (
              (-0.436802314829 0.248473024082 -0.0968023148294 0.368473024082)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (0.0181976851706 -0.181526975918 0.0581976851706 -0.141526975918)
            )
          )
          (:yaw_rotation (
              (1.57079632679 1.57079632679)
            )
          )
      )
