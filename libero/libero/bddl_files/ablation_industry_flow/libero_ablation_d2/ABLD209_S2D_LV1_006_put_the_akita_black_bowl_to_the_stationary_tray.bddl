(define (problem LIBERO_Industry_Workbench_Ablation)
  (:domain robosuite)
  (:language put the akita black bowl to the tray)
    (:regions
      (object_init
          (:target industry_workbench)
          (:ranges (
              (-0.295779403477 -0.111542620383 -0.275775403477 -0.0715386203826)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (0.0435708849483 0.00345737961736 0.0435748849483 0.00346137961736)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (goal_region
          (:target cosmetics_tray_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
  )

  (:objects
    cosmetics_tray_1 - cosmetics_tray
    ablation_akita_black_bowl_1 - ablation_akita_black_bowl
  )

  (:obj_of_interest
    ablation_akita_black_bowl_1
  )

  (:init
    (On cosmetics_tray_1 industry_workbench_tray_init)
    (On ablation_akita_black_bowl_1 industry_workbench_object_init)
  )

  (:goal
    (And (ReleasedOn ablation_akita_black_bowl_1 cosmetics_tray_1_goal_region))
  )
)
