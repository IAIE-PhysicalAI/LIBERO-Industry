(define (problem LIBERO_Industry_Workbench_Ablation)
  (:domain robosuite)
  (:language put the akita black bowl to the tray)
    (:regions
      (object_init
          (:target industry_workbench)
          (:ranges (
              (-0.375286486738 -0.114800162067 -0.355282486738 -0.0747961620675)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.035936198313 0.000199837932527 -0.035932198313 0.000203837932527)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (goal_region
          (:target cosmetics_tray_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
  )

  (:objects
    cosmetics_tray_1 - cosmetics_tray
    ablation_akita_black_bowl_1 - ablation_akita_black_bowl
