(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.0974079776670766 -0.0904251225207567 -0.0974059776670766 -0.0904231225207567)
            )
          )
          (:yaw_rotation (
              (5.004297694033222 5.004297694033222)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.1774317113910223 0.17588332595931785 -0.1774297113910223 0.17588532595931786)
            )
          )
          (:yaw_rotation (
              (4.508941586281147 4.508941586281147)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_upright_1 cream_jar_upright_2 cream_jar_upright_3 - cream_jar_upright
    cream_jar_flat_1 - cream_jar_flat
    serum_bottle_flat_1 - serum_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_upright_inlay y pulse -0.0326 service_2.5)
    (On cream_jar_upright_1 grey_plate_1_place_region_3)
    (On cream_jar_upright_2 grey_plate_1_place_region_5)
    (On cream_jar_flat_1 grey_plate_1_place_region_6)
    (On serum_bottle_flat_1 grey_plate_1_place_region_1)
    (On cream_jar_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_jar_upright_1 conveyor_ghost_1) (Routed cream_jar_upright_2 conveyor_ghost_1) (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_upright_3 conveyor_ghost_1))
  )

)
