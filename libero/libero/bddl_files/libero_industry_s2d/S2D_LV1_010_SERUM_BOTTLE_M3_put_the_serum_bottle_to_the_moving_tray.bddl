(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.021356899686045497 -0.0010322163172884747 0.0213588996860455 -0.0010302163172884748)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21299338873939858 -0.0010322163172884747 -0.21299138873939857 -0.0010302163172884748)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 - serum_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse -0.0298 service_1.5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_2)
    (On serum_bottle_flat_2 grey_plate_1_place_region_4)
    (On serum_bottle_flat_3 grey_plate_1_place_region_6)
  )

  (:goal
    (And (DynamicOn serum_bottle_flat_1 conveyor_ghost_1) (DynamicOn serum_bottle_flat_2 conveyor_ghost_1) (DynamicOn serum_bottle_flat_3 conveyor_ghost_1))
  )

)
