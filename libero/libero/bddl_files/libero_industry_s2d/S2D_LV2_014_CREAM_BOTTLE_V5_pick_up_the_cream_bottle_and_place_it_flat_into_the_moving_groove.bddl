(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.022777871014305257 -0.033954267544223544 -0.022775871014305255 -0.03395226754422354)
            )
          )
          (:yaw_rotation (
              (-0.06721203901577408 -0.06721203901577408)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2422811376534805 -0.019178749457499127 -0.2422791376534805 -0.019176749457499125)
            )
          )
          (:yaw_rotation (
              (1.5035842877791226 1.5035842877791226)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 - cream_bottle_flat
    cream_jar_flat_1 - cream_jar_flat
    pump_bottle_upright_1 - pump_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_groove y pulse 0.0507 service_2.0)
    (On cream_bottle_flat_1 grey_plate_1_place_region_4)
    (On cream_bottle_flat_2 grey_plate_1_place_region_3)
    (On cream_bottle_flat_3 grey_plate_1_place_region_2)
    (On cream_jar_flat_1 grey_plate_1_place_region_5)
    (On pump_bottle_upright_1 grey_plate_1_place_region_1)
  )

  (:goal
    (And (Routed cream_bottle_flat_1 conveyor_ghost_1) (Routed cream_bottle_flat_2 conveyor_ghost_1) (Routed cream_bottle_flat_3 conveyor_ghost_1))
  )

)
