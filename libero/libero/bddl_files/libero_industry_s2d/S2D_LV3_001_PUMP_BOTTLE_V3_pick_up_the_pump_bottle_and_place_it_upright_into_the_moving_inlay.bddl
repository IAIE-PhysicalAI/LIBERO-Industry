(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.1086328084097822 -0.13102221749534046 -0.1086308084097822 -0.13102021749534046)
            )
          )
          (:yaw_rotation (
              (5.026886422783561 5.026886422783561)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.17382043064464897 0.06937403651499668 -0.17381843064464897 0.06937603651499669)
            )
          )
          (:yaw_rotation (
              (5.026246483432237 5.026246483432237)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 pump_bottle_upright_4 - pump_bottle_upright
    serum_bottle_flat_1 - serum_bottle_flat
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_upright_inlay y pulse 0.0474 service_2.5)
    (On pump_bottle_upright_4 grey_plate_1_place_region_5)
    (On pump_bottle_upright_1 grey_plate_1_place_region_1)
    (On pump_bottle_upright_2 grey_plate_1_place_region_6)
    (On serum_bottle_flat_1 grey_plate_1_place_region_2)
    (On cream_bottle_upright_1 grey_plate_1_place_region_3)
    (On pump_bottle_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed pump_bottle_upright_4 conveyor_ghost_1) (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1) (Routed pump_bottle_upright_3 conveyor_ghost_1))
  )

)
