(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.014037519650840295 0.007646365032355519 -0.014035519650840296 0.007648365032355519)
            )
          )
          (:yaw_rotation (
              (0.012079723938429633 0.012079723938429633)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2259920545362677 0.005085888220867716 -0.2259900545362677 0.005087888220867716)
            )
          )
          (:yaw_rotation (
              (1.5828760507333262 1.5828760507333262)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 - serum_bottle_flat
    cream_bottle_flat_1 - cream_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_groove y pulse 0.0782 service_2.0)
    (On serum_bottle_flat_1 grey_plate_1_place_region_3)
    (On serum_bottle_flat_2 grey_plate_1_place_region_2)
    (On serum_bottle_flat_3 grey_plate_1_place_region_4)
    (On cream_bottle_flat_1 grey_plate_1_place_region_6)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1))
  )

)
