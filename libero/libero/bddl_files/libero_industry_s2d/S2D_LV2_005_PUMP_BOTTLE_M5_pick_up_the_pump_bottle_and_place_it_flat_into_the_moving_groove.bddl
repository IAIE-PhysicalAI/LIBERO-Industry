(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.031961186770025254 -0.012056948405556558 0.031963186770025256 -0.01205494840555656)
            )
          )
          (:yaw_rotation (
              (0.10333515949933428 0.10333515949933428)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.18154379965461784 -0.03419838629501991 -0.18154179965461784 -0.03419638629501991)
            )
          )
          (:yaw_rotation (
              (1.6741314862942307 1.6741314862942307)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_flat_1 pump_bottle_flat_2 pump_bottle_flat_3 - pump_bottle_flat
    cream_jar_upright_1 - cream_jar_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_flat_groove y pulse -0.0498 service_2.0)
    (On pump_bottle_flat_1 grey_plate_1_place_region_1)
    (On pump_bottle_flat_2 grey_plate_1_place_region_6)
    (On pump_bottle_flat_3 grey_plate_1_place_region_3)
    (On cream_jar_upright_1 grey_plate_1_place_region_2)
  )

  (:goal
    (And (Routed pump_bottle_flat_1 conveyor_ghost_1) (Routed pump_bottle_flat_2 conveyor_ghost_1) (Routed pump_bottle_flat_3 conveyor_ghost_1))
  )

)
