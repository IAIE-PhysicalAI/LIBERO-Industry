(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.15186751508274002 -0.11272611723997662 -0.15186551508274002 -0.11272411723997662)
            )
          )
          (:yaw_rotation (
              (1.5926955322721847 1.5926955322721847)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.15692174137237516 0.11803194877818286 -0.15691974137237516 0.11803394877818287)
            )
          )
          (:yaw_rotation (
              (3.1634918590670815 3.1634918590670815)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 serum_bottle_flat_4 - serum_bottle_flat
    cream_bottle_upright_1 cream_bottle_upright_2 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_inlay y pulse 0.0364 service_2.5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_3)
    (On serum_bottle_flat_2 grey_plate_1_place_region_5)
    (On serum_bottle_flat_3 grey_plate_1_place_region_4)
    (On cream_bottle_upright_1 grey_plate_1_place_region_6)
    (On cream_bottle_upright_2 grey_plate_1_place_region_1)
    (On serum_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1) (Routed serum_bottle_flat_4 conveyor_ghost_1))
  )

)
