(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.01270548900552469 0.04206799994166152 -0.012703489005524692 0.04206999994166152)
            )
          )
          (:yaw_rotation (
              (3.3615044645886543 3.3615044645886543)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.23796014832841253 -0.0082824587370621 -0.23795814832841253 -0.008280458737062102)
            )
          )
          (:yaw_rotation (
              (4.932300791383551 4.932300791383551)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 serum_bottle_flat_4 - serum_bottle_flat
    pump_bottle_flat_1 - pump_bottle_flat
    pump_bottle_upright_1 - pump_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_inlay y pulse -0.0568 service_2.5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_2)
    (On serum_bottle_flat_2 grey_plate_1_place_region_1)
    (On serum_bottle_flat_3 grey_plate_1_place_region_6)
    (On pump_bottle_flat_1 grey_plate_1_place_region_4)
    (On pump_bottle_upright_1 grey_plate_1_place_region_5)
    (On serum_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1) (Routed serum_bottle_flat_4 conveyor_ghost_1))
  )

)
