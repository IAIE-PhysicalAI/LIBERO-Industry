(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.038737207324615414 -0.014289063771456863 0.038739207324615416 -0.014287063771456865)
            )
          )
          (:yaw_rotation (
              (0.11795055484756335 0.11795055484756335)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.1717600027050092 -0.03923311055108185 -0.1717580027050092 -0.039231110551081846)
            )
          )
          (:yaw_rotation (
              (1.6887468816424598 1.6887468816424598)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 - serum_bottle_flat
    cream_bottle_flat_1 - cream_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_groove y pulse 0.0334 service_2.0)
    (On serum_bottle_flat_1 grey_plate_1_place_region_6)
    (On serum_bottle_flat_2 grey_plate_1_place_region_4)
    (On serum_bottle_flat_3 grey_plate_1_place_region_5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_2)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1))
  )

)
