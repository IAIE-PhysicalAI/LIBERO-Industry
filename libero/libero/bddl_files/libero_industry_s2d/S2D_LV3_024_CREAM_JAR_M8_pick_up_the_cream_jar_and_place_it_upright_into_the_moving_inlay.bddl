(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.009309555479524027 0.03103257699257421 -0.009307555479524028 0.03103457699257421)
            )
          )
          (:yaw_rotation (
              (0.14386339341932983 0.14386339341932983)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.25506527788297617 -0.004568623577139371 -0.2550632778829762 -0.004566623577139371)
            )
          )
          (:yaw_rotation (
              (-0.09108111934216433 -0.09108111934216433)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_upright_1 cream_jar_upright_2 cream_jar_upright_3 - cream_jar_upright
    cream_jar_flat_1 - cream_jar_flat
    serum_bottle_upright_1 - serum_bottle_upright
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_upright_inlay y pulse -0.0707 service_2.5)
    (On cream_jar_upright_1 grey_plate_1_place_region_1)
    (On cream_jar_upright_2 grey_plate_1_place_region_3)
    (On cream_jar_flat_1 grey_plate_1_place_region_2)
    (On serum_bottle_upright_1 grey_plate_1_place_region_4)
    (On cream_bottle_upright_1 grey_plate_1_place_region_5)
    (On cream_jar_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_jar_upright_1 conveyor_ghost_1) (Routed cream_jar_upright_2 conveyor_ghost_1) (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_upright_3 conveyor_ghost_1))
  )

)
