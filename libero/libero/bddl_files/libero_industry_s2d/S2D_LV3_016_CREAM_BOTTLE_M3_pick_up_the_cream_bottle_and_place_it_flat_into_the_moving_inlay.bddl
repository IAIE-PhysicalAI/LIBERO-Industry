(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.07440087620792904 0.14991829931362308 -0.07439887620792904 0.14992029931362308)
            )
          )
          (:yaw_rotation (
              (1.5665362227191884 1.5665362227191884)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.0753593897391249 -0.07507801899958878 -0.0753573897391249 -0.07507601899958878)
            )
          )
          (:yaw_rotation (
              (3.137332549514085 3.137332549514085)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 cream_bottle_flat_4 - cream_bottle_flat
    serum_bottle_flat_1 serum_bottle_flat_2 - serum_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_inlay y pulse -0.0342 service_2.5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_1)
    (On cream_bottle_flat_2 grey_plate_1_place_region_2)
    (On cream_bottle_flat_3 grey_plate_1_place_region_4)
    (On serum_bottle_flat_1 grey_plate_1_place_region_6)
    (On serum_bottle_flat_2 grey_plate_1_place_region_5)
    (On cream_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_bottle_flat_1 conveyor_ghost_1) (Routed cream_bottle_flat_2 conveyor_ghost_1) (Routed cream_bottle_flat_3 conveyor_ghost_1) (Routed cream_bottle_flat_4 conveyor_ghost_1))
  )

)
