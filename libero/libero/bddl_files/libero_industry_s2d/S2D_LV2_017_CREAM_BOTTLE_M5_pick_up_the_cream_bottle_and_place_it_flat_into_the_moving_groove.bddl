(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.003016181842415553 0.0641632914097664 -0.0030141818424155526 0.0641652914097664)
            )
          )
          (:yaw_rotation (
              (0.14062637727914912 0.14062637727914912)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2208444288143569 0.033327357483080494 -0.2208424288143569 0.033329357483080496)
            )
          )
          (:yaw_rotation (
              (1.7114227040740457 1.7114227040740457)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 - cream_bottle_flat
    pump_bottle_flat_1 - pump_bottle_flat
