(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.050801466116544375 0.03487647948707331 0.05080346611654438 0.03487847948707331)
            )
          )
          (:yaw_rotation (
              (-0.12028453087748152 -0.12028453087748152)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.16760893132982413 0.06127531066042947 -0.16760693132982413 0.06127731066042947)
            )
          )
          (:yaw_rotation (
              (1.450511795917415 1.450511795917415)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 - cream_bottle_flat
    serum_bottle_upright_1 - serum_bottle_upright
    pump_bottle_upright_1 - pump_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_groove y pulse -0.0793 service_2.0)
    (On cream_bottle_flat_1 grey_plate_1_place_region_6)
    (On cream_bottle_flat_2 grey_plate_1_place_region_5)
    (On cream_bottle_flat_3 grey_plate_1_place_region_4)
    (On serum_bottle_upright_1 grey_plate_1_place_region_1)
    (On pump_bottle_upright_1 grey_plate_1_place_region_3)
  )

  (:goal
    (And (Routed cream_bottle_flat_1 conveyor_ghost_1) (Routed cream_bottle_flat_2 conveyor_ghost_1) (Routed cream_bottle_flat_3 conveyor_ghost_1))
  )

)
