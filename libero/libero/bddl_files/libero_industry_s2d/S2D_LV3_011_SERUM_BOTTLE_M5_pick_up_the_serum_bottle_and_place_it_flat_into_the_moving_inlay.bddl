(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.01893990511422891 0.05781315855662453 0.018941905114228913 0.05781515855662453)
            )
          )
          (:yaw_rotation (
              (0.27083645432572123 0.27083645432572123)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.20345976764954748 -0.003938082648660415 -0.20345776764954748 -0.003936082648660415)
            )
          )
          (:yaw_rotation (
              (1.841632781120618 1.841632781120618)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 serum_bottle_flat_4 serum_bottle_flat_5 - serum_bottle_flat
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_inlay y pulse -0.066 service_2.5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_3)
    (On serum_bottle_flat_2 grey_plate_1_place_region_1)
    (On serum_bottle_flat_3 grey_plate_1_place_region_2)
    (On cream_bottle_upright_1 grey_plate_1_place_region_5)
    (On serum_bottle_flat_4 conveyor_ghost_1)
    (On serum_bottle_flat_5 conveyor_ghost_1)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1) (Routed serum_bottle_flat_4 conveyor_ghost_1) (Routed serum_bottle_flat_5 conveyor_ghost_1))
  )

)
