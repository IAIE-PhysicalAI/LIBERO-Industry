(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.0004850637410949442 -0.0020630462585297374 0.00048706374109494424 -0.002061046258529737)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.23386522468434912 -0.0020630462585297374 -0.2338632246843491 -0.002061046258529737)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 - cream_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cosmetics_tray y pulse -0.081 service_1.5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_4)
    (On cream_bottle_flat_2 grey_plate_1_place_region_1)
    (On cream_bottle_flat_3 grey_plate_1_place_region_3)
  )

  (:goal
    (And (DynamicOn cream_bottle_flat_1 conveyor_ghost_1) (DynamicOn cream_bottle_flat_2 conveyor_ghost_1) (DynamicOn cream_bottle_flat_3 conveyor_ghost_1))
  )

)
