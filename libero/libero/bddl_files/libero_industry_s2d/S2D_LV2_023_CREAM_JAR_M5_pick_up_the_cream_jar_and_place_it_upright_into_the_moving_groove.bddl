(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.004077484381527662 -0.03458135734785521 -0.004075484381527662 -0.03457935734785521)
            )
          )
          (:yaw_rotation (
              (0.06104877905859663 0.06104877905859663)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2201690854457917 -0.04778989904275115 -0.2201670854457917 -0.047787899042751145)
            )
          )
          (:yaw_rotation (
              (-0.08044474685365614 -0.08044474685365614)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_flat_1 cream_jar_flat_2 cream_jar_flat_3 - cream_jar_flat
    serum_bottle_flat_1 - serum_bottle_flat
    serum_bottle_upright_1 - serum_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_flat_groove y pulse -0.046 service_2.0)
    (On cream_jar_flat_1 grey_plate_1_place_region_2)
    (On cream_jar_flat_2 grey_plate_1_place_region_4)
    (On cream_jar_flat_3 grey_plate_1_place_region_1)
    (On serum_bottle_flat_1 grey_plate_1_place_region_5)
    (On serum_bottle_upright_1 grey_plate_1_place_region_3)
  )

  (:goal
    (And (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_flat_2 conveyor_ghost_1) (Routed cream_jar_flat_3 conveyor_ghost_1))
  )

)
