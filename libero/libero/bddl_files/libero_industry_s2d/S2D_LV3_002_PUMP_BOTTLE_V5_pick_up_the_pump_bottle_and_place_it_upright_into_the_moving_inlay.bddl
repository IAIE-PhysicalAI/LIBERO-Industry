(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.0004093381753331192 0.0019854915213412946 0.00041133817533311925 0.001987491521341295)
            )
          )
          (:yaw_rotation (
              (3.229973771139708 3.229973771139708)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.23966684347656622 -0.01928812956832894 -0.23966484347656622 -0.01928612956832894)
            )
          )
          (:yaw_rotation (
              (3.045984469256446 3.045984469256446)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 pump_bottle_upright_4 pump_bottle_upright_5 - pump_bottle_upright
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_upright_inlay y pulse 0.0482 service_2.5)
    (On pump_bottle_upright_5 grey_plate_1_place_region_1)
    (On pump_bottle_upright_1 grey_plate_1_place_region_5)
    (On pump_bottle_upright_2 grey_plate_1_place_region_4)
    (On cream_bottle_upright_1 grey_plate_1_place_region_6)
    (On pump_bottle_upright_3 conveyor_ghost_1)
    (On pump_bottle_upright_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed pump_bottle_upright_5 conveyor_ghost_1) (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1) (Routed pump_bottle_upright_3 conveyor_ghost_1) (Routed pump_bottle_upright_4 conveyor_ghost_1))
  )

)
