(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.009039179293386794 -0.03616553312069671 -0.009037179293386795 -0.03616353312069671)
            )
          )
          (:yaw_rotation (
              (2.849039608546504 2.849039608546504)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.23004549010155095 0.030400530446208336 -0.23004349010155095 0.030402530446208338)
            )
          )
          (:yaw_rotation (
              (4.419835935341401 4.419835935341401)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 serum_bottle_flat_4 - serum_bottle_flat
    cream_jar_upright_1 - cream_jar_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_inlay y pulse -0.0583 service_2.5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_2)
    (On serum_bottle_flat_2 grey_plate_1_place_region_1)
    (On serum_bottle_flat_3 grey_plate_1_place_region_6)
    (On cream_jar_upright_1 grey_plate_1_place_region_3)
    (On serum_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1) (Routed serum_bottle_flat_4 conveyor_ghost_1))
  )

)
