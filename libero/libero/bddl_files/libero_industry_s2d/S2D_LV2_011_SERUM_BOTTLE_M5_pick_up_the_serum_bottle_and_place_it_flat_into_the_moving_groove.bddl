(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.01136020722120166 0.03063692506445672 0.011362207221201659 0.030638925064456722)
            )
          )
          (:yaw_rotation (
              (-0.14505067587275122 -0.14505067587275122)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.19838380727356486 0.06127561439052207 -0.19838180727356486 0.061277614390522074)
            )
          )
          (:yaw_rotation (
              (1.4257456509221453 1.4257456509221453)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
