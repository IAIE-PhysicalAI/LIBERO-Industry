  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_groove y pulse -0.0459 service_2.0)
    (On serum_bottle_flat_1 grey_plate_1_place_region_4)
    (On serum_bottle_flat_2 grey_plate_1_place_region_2)
    (On serum_bottle_flat_3 grey_plate_1_place_region_3)
    (On pump_bottle_upright_1 grey_plate_1_place_region_6)
  )

  (:goal
