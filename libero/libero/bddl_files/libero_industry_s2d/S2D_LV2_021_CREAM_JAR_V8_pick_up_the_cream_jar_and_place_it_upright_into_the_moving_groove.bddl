(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.028376005552377105 0.06073405438359755 -0.028374005552377103 0.060736054383597554)
            )
          )
          (:yaw_rotation (
              (0.1667679464300901 0.1667679464300901)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2521694137986846 0.023062604249768248 -0.2521674137986847 0.02306460424976825)
            )
          )
          (:yaw_rotation (
              (-0.043954081359791085 -0.043954081359791085)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_flat_1 cream_jar_flat_2 cream_jar_flat_3 - cream_jar_flat
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_flat_groove y pulse 0.0797 service_2.0)
    (On cream_jar_flat_1 grey_plate_1_place_region_1)
    (On cream_jar_flat_2 grey_plate_1_place_region_5)
    (On cream_jar_flat_3 grey_plate_1_place_region_4)
    (On cream_bottle_upright_1 grey_plate_1_place_region_6)
  )

  (:goal
    (And (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_flat_2 conveyor_ghost_1) (Routed cream_jar_flat_3 conveyor_ghost_1))
  )

)
