(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.1232461433260948 -0.1494969745045777 -0.1232441433260948 -0.1494949745045777)
            )
          )
          (:yaw_rotation (
              (1.5327073885257212 1.5327073885257212)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.11483335146763445 0.07126851576155308 -0.11483135146763444 0.07127051576155308)
            )
          )
          (:yaw_rotation (
              (1.473966155586431 1.473966155586431)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 pump_bottle_upright_4 - pump_bottle_upright
    cream_bottle_upright_1 - cream_bottle_upright
    serum_bottle_upright_1 - serum_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_upright_inlay y pulse -0.056 service_2.5)
    (On pump_bottle_upright_3 grey_plate_1_place_region_2)
    (On pump_bottle_upright_4 grey_plate_1_place_region_3)
    (On pump_bottle_upright_1 grey_plate_1_place_region_6)
    (On cream_bottle_upright_1 grey_plate_1_place_region_4)
    (On serum_bottle_upright_1 grey_plate_1_place_region_5)
    (On pump_bottle_upright_2 conveyor_ghost_1)
  )

  (:goal
    (And (Routed pump_bottle_upright_3 conveyor_ghost_1) (Routed pump_bottle_upright_4 conveyor_ghost_1) (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1))
  )

)
