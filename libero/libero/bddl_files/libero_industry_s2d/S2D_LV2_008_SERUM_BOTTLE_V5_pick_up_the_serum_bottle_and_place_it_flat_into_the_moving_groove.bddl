(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.04740128135532545 -0.01247143786324476 -0.04739928135532545 -0.012469437863244762)
            )
          )
          (:yaw_rotation (
              (0.06724085582756543 0.06724085582756543)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2588922684321262 -0.026713744041686527 -0.25889026843212626 -0.026711744041686525)
            )
          )
          (:yaw_rotation (
              (1.638037182622462 1.638037182622462)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 - serum_bottle_flat
    pump_bottle_flat_1 - pump_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_groove y pulse 0.0533 service_2.0)
    (On serum_bottle_flat_1 grey_plate_1_place_region_4)
    (On serum_bottle_flat_2 grey_plate_1_place_region_3)
    (On serum_bottle_flat_3 grey_plate_1_place_region_6)
    (On pump_bottle_flat_1 grey_plate_1_place_region_1)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1))
  )

)
