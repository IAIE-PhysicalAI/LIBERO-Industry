(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.0014136032909183385 -0.01859500970457367 0.0014156032909183383 -0.018593009704573667)
            )
          )
          (:yaw_rotation (
              (-0.10524086397902559 -0.10524086397902559)
            )
          )
      )
