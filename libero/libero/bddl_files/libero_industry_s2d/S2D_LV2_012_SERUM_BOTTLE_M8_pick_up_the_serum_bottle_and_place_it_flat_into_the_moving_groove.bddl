          (:ranges (
              (-0.20938362809175295 0.003671739977419844 -0.20938162809175295 0.0036737399774198444)
            )
          )
          (:yaw_rotation (
              (1.4655554628158711 1.4655554628158711)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
