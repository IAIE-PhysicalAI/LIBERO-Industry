(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.008792529828176186 0.024787573576761455 -0.008790529828176187 0.024789573576761457)
            )
          )
          (:yaw_rotation (
              (-0.028833112374652553 -0.028833112374652553)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.22335331154566387 0.030975743643962574 -0.22335131154566387 0.030977743643962576)
            )
          )
          (:yaw_rotation (
              (1.5419632144202442 1.5419632144202442)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_flat_1 pump_bottle_flat_2 pump_bottle_flat_3 - pump_bottle_flat
    cream_jar_flat_1 - cream_jar_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_flat_groove y pulse 0.0531 service_2.0)
    (On pump_bottle_flat_1 grey_plate_1_place_region_3)
    (On pump_bottle_flat_2 grey_plate_1_place_region_4)
    (On pump_bottle_flat_3 grey_plate_1_place_region_5)
    (On cream_jar_flat_1 grey_plate_1_place_region_1)
  )

  (:goal
    (And (Routed pump_bottle_flat_1 conveyor_ghost_1) (Routed pump_bottle_flat_2 conveyor_ghost_1) (Routed pump_bottle_flat_3 conveyor_ghost_1))
  )

)
