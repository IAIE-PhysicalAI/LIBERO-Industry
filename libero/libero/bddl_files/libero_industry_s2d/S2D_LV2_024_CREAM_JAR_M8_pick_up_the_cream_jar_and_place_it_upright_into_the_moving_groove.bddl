(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.031229775861032635 -0.0363983578555076 0.031231775861032637 -0.0363963578555076)
            )
          )
          (:yaw_rotation (
              (0.09739731359800143 0.09739731359800143)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.1997985492509545 -0.05897131875085676 -0.1997965492509545 -0.05896931875085676)
            )
          )
          (:yaw_rotation (
              (-0.15004983839287106 -0.15004983839287106)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
