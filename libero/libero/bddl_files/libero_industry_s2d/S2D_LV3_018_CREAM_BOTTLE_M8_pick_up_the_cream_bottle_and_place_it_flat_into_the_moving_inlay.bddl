(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.10267566378592803 0.12875879379856456 -0.10267366378592803 0.12876079379856456)
            )
          )
          (:yaw_rotation (
              (4.430574995557754 4.430574995557754)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.16524737760937672 -0.08736395519349792 -0.16524537760937671 -0.08736195519349792)
            )
          )
          (:yaw_rotation (
              (6.00137132235265 6.00137132235265)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 cream_bottle_flat_4 - cream_bottle_flat
    serum_bottle_flat_1 - serum_bottle_flat
    pump_bottle_upright_1 - pump_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_inlay y pulse -0.062 service_2.5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_3)
    (On cream_bottle_flat_2 grey_plate_1_place_region_6)
    (On cream_bottle_flat_3 grey_plate_1_place_region_5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_2)
    (On pump_bottle_upright_1 grey_plate_1_place_region_1)
    (On cream_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_bottle_flat_1 conveyor_ghost_1) (Routed cream_bottle_flat_2 conveyor_ghost_1) (Routed cream_bottle_flat_3 conveyor_ghost_1) (Routed cream_bottle_flat_4 conveyor_ghost_1))
  )

)
