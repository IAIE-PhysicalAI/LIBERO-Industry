(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.00014434802415893528 -0.0061481413982593614 0.00014634802415893527 -0.006146141398259361)
            )
          )
          (:yaw_rotation (
              (-0.08350187469418001 -0.08350187469418001)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21375775635754501 0.011754714270002976 -0.213755756357545 0.011756714270002975)
            )
          )
          (:yaw_rotation (
              (1.4872944521007165 1.4872944521007165)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_flat_1 pump_bottle_flat_2 pump_bottle_flat_3 - pump_bottle_flat
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_flat_groove y pulse 0.0793 service_2.0)
    (On pump_bottle_flat_1 grey_plate_1_place_region_4)
    (On pump_bottle_flat_2 grey_plate_1_place_region_1)
    (On pump_bottle_flat_3 grey_plate_1_place_region_5)
    (On cream_bottle_upright_1 grey_plate_1_place_region_6)
  )

  (:goal
    (And (Routed pump_bottle_flat_1 conveyor_ghost_1) (Routed pump_bottle_flat_2 conveyor_ghost_1) (Routed pump_bottle_flat_3 conveyor_ghost_1))
  )

)
