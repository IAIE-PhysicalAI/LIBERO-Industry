(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.002583952712249523 -0.028656415918326315 -0.0025819527122495226 -0.028654415918326313)
            )
          )
          (:yaw_rotation (
              (2.859082582651089 2.859082582651089)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.21029349200519656 0.03163624561098272 -0.21029149200519656 0.031638245610982725)
            )
          )
          (:yaw_rotation (
              (2.8267332156662506 2.8267332156662506)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_flat_1 cream_jar_flat_2 - cream_jar_flat
    cream_jar_upright_1 cream_jar_upright_2 cream_jar_upright_3 - cream_jar_upright
    serum_bottle_flat_1 - serum_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_upright_inlay y pulse -0.0605 service_2.5)
    (On cream_jar_flat_1 grey_plate_1_place_region_6)
    (On cream_jar_flat_2 grey_plate_1_place_region_2)
    (On cream_jar_upright_1 grey_plate_1_place_region_1)
    (On serum_bottle_flat_1 grey_plate_1_place_region_5)
    (On cream_jar_upright_2 conveyor_ghost_1)
    (On cream_jar_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_flat_2 conveyor_ghost_1) (Routed cream_jar_upright_1 conveyor_ghost_1) (Routed cream_jar_upright_2 conveyor_ghost_1) (Routed cream_jar_upright_3 conveyor_ghost_1))
  )

)
