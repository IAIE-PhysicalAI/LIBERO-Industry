(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.006162849043491416 0.0013677100223358125 -0.006160849043491416 0.0013697100223358123)
            )
          )
          (:yaw_rotation (
              (-0.2687405175344867 -0.2687405175344867)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.22308513488165724 0.06110868347803612 -0.22308313488165724 0.061110683478036124)
            )
          )
          (:yaw_rotation (
              (1.30205580926041 1.30205580926041)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 cream_bottle_flat_4 - cream_bottle_flat
    cream_jar_upright_1 - cream_jar_upright
    serum_bottle_upright_1 - serum_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_inlay y pulse 0.0338 service_2.5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_1)
    (On cream_bottle_flat_2 grey_plate_1_place_region_3)
    (On cream_bottle_flat_3 grey_plate_1_place_region_6)
    (On cream_jar_upright_1 grey_plate_1_place_region_4)
    (On serum_bottle_upright_1 grey_plate_1_place_region_5)
    (On cream_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_bottle_flat_1 conveyor_ghost_1) (Routed cream_bottle_flat_2 conveyor_ghost_1) (Routed cream_bottle_flat_3 conveyor_ghost_1) (Routed cream_bottle_flat_4 conveyor_ghost_1))
  )

)
