(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.024962580827302377 -0.03865926133819638 0.02496458082730238 -0.03865726133819638)
            )
          )
          (:yaw_rotation (
              (-0.06523831932406776 -0.06523831932406776)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.19456942097897367 -0.024317009669465768 -0.19456742097897367 -0.024315009669465766)
            )
          )
          (:yaw_rotation (
              (1.505558007470829 1.505558007470829)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 - cream_bottle_flat
    serum_bottle_upright_1 - serum_bottle_upright
