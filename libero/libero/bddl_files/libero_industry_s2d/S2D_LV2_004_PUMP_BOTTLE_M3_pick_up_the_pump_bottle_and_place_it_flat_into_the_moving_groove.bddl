(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.011340332456537655 0.00013143310484668814 -0.011338332456537656 0.00013343310484668813)
            )
          )
          (:yaw_rotation (
              (-0.037553421219398336 -0.037553421219398336)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2258389941483502 0.008190380456787093 -0.2258369941483502 0.008192380456787092)
            )
          )
          (:yaw_rotation (
              (1.5332429055754984 1.5332429055754984)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_flat_1 pump_bottle_flat_2 pump_bottle_flat_3 - pump_bottle_flat
    serum_bottle_flat_1 - serum_bottle_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_flat_groove y pulse -0.0294 service_2.0)
    (On pump_bottle_flat_1 grey_plate_1_place_region_5)
    (On pump_bottle_flat_2 grey_plate_1_place_region_3)
    (On pump_bottle_flat_3 grey_plate_1_place_region_1)
    (On serum_bottle_flat_1 grey_plate_1_place_region_6)
  )

  (:goal
    (And (Routed pump_bottle_flat_1 conveyor_ghost_1) (Routed pump_bottle_flat_2 conveyor_ghost_1) (Routed pump_bottle_flat_3 conveyor_ghost_1))
  )

)
