(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.11581393950299462 -0.08805186927545076 -0.11581193950299462 -0.08804986927545076)
            )
          )
          (:yaw_rotation (
              (1.8592307191052024 1.8592307191052024)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.18146919280808385 0.13322672876166777 -0.18146719280808385 0.13322872876166778)
            )
          )
          (:yaw_rotation (
              (3.4300270459000988 3.4300270459000988)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    serum_bottle_flat_1 serum_bottle_flat_2 serum_bottle_flat_3 serum_bottle_flat_4 serum_bottle_flat_5 - serum_bottle_flat
    cream_bottle_upright_1 - cream_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 serum_bottle_flat_inlay y pulse 0.0361 service_2.5)
    (On serum_bottle_flat_1 grey_plate_1_place_region_6)
    (On serum_bottle_flat_2 grey_plate_1_place_region_4)
    (On serum_bottle_flat_3 grey_plate_1_place_region_1)
    (On cream_bottle_upright_1 grey_plate_1_place_region_3)
    (On serum_bottle_flat_4 conveyor_ghost_1)
    (On serum_bottle_flat_5 conveyor_ghost_1)
  )

  (:goal
    (And (Routed serum_bottle_flat_1 conveyor_ghost_1) (Routed serum_bottle_flat_2 conveyor_ghost_1) (Routed serum_bottle_flat_3 conveyor_ghost_1) (Routed serum_bottle_flat_4 conveyor_ghost_1) (Routed serum_bottle_flat_5 conveyor_ghost_1))
  )

)
