(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.04195453129688462 -0.018972866771084715 0.04195653129688462 -0.018970866771084713)
            )
          )
          (:yaw_rotation (
              (0.07464520502908453 0.07464520502908453)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.17957328564774253 -0.03553963702130171 -0.17957128564774252 -0.03553763702130171)
            )
          )
          (:yaw_rotation (
              (-0.10358973542970587 -0.10358973542970587)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_jar_flat_1 cream_jar_flat_2 cream_jar_flat_3 - cream_jar_flat
    serum_bottle_flat_1 - serum_bottle_flat
    serum_bottle_upright_1 - serum_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_jar_flat_groove y pulse 0.0276 service_2.0)
    (On cream_jar_flat_1 grey_plate_1_place_region_2)
    (On cream_jar_flat_2 grey_plate_1_place_region_4)
    (On cream_jar_flat_3 grey_plate_1_place_region_1)
    (On serum_bottle_flat_1 grey_plate_1_place_region_6)
    (On serum_bottle_upright_1 grey_plate_1_place_region_5)
  )

  (:goal
    (And (Routed cream_jar_flat_1 conveyor_ghost_1) (Routed cream_jar_flat_2 conveyor_ghost_1) (Routed cream_jar_flat_3 conveyor_ghost_1))
  )

)
