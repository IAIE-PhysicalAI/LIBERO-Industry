(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.05474489356252682 -0.013745952238869485 0.05474689356252682 -0.013743952238869487)
            )
          )
          (:yaw_rotation (
              (-0.11524142041788904 -0.11524142041788904)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.1893893302872615 0.014513634673520934 -0.18938733028726148 0.014515634673520933)
            )
          )
          (:yaw_rotation (
              (-0.33162091726557363 -0.33162091726557363)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    pump_bottle_upright_1 pump_bottle_upright_2 pump_bottle_upright_3 pump_bottle_upright_4 - pump_bottle_upright
    cream_bottle_flat_1 - cream_bottle_flat
    serum_bottle_upright_1 - serum_bottle_upright
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 pump_bottle_upright_inlay y pulse -0.0438 service_2.5)
    (On pump_bottle_upright_4 grey_plate_1_place_region_1)
    (On pump_bottle_upright_1 grey_plate_1_place_region_4)
    (On pump_bottle_upright_2 grey_plate_1_place_region_2)
    (On cream_bottle_flat_1 grey_plate_1_place_region_3)
    (On serum_bottle_upright_1 grey_plate_1_place_region_6)
    (On pump_bottle_upright_3 conveyor_ghost_1)
  )

  (:goal
    (And (Routed pump_bottle_upright_4 conveyor_ghost_1) (Routed pump_bottle_upright_1 conveyor_ghost_1) (Routed pump_bottle_upright_2 conveyor_ghost_1) (Routed pump_bottle_upright_3 conveyor_ghost_1))
  )

)
