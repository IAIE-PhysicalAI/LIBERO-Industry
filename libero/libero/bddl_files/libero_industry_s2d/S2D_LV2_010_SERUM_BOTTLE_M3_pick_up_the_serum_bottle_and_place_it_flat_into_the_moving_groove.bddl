(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.02593461790821204 -0.02909146182689691 0.025936617908212042 -0.02908946182689691)
            )
          )
          (:yaw_rotation (
              (0.09294989793629979 0.09294989793629979)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.18512036430660347 -0.04876569325544146 -0.18511836430660347 -0.048763693255441456)
            )
          )
          (:yaw_rotation (
              (1.6637462247311963 1.6637462247311963)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
