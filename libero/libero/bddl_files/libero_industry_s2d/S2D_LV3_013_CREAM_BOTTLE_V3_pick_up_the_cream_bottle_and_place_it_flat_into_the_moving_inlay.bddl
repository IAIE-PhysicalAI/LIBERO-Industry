(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (-0.035801694581666064 0.021733160560807693 -0.03579969458166606 0.021735160560807695)
            )
          )
          (:yaw_rotation (
              (-0.11156138946311056 -0.11156138946311056)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.2594013477189754 0.046782254747315774 -0.25939934771897544 0.046784254747315776)
            )
          )
          (:yaw_rotation (
              (1.459234937331786 1.459234937331786)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 cream_bottle_flat_4 - cream_bottle_flat
    cream_jar_flat_1 - cream_jar_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_inlay y pulse 0.044 service_2.5)
    (On cream_bottle_flat_1 grey_plate_1_place_region_4)
    (On cream_bottle_flat_2 grey_plate_1_place_region_6)
    (On cream_bottle_flat_3 grey_plate_1_place_region_2)
    (On cream_jar_flat_1 grey_plate_1_place_region_1)
    (On cream_bottle_flat_4 conveyor_ghost_1)
  )

  (:goal
    (And (Routed cream_bottle_flat_1 conveyor_ghost_1) (Routed cream_bottle_flat_2 conveyor_ghost_1) (Routed cream_bottle_flat_3 conveyor_ghost_1) (Routed cream_bottle_flat_4 conveyor_ghost_1))
  )

)
