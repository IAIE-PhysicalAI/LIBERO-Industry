(define (problem LIBERO_Industry_Workbench_Manipulation)
  (:domain robosuite)
  (:language route cosmetics)
    (:regions
      (ghost_init
          (:target industry_workbench)
          (:ranges (
              (0.03943824768723371 -0.05286187613828228 0.03944024768723371 -0.052859876138282275)
            )
          )
          (:yaw_rotation (
              (-0.09497435664953759 -0.09497435664953759)
            )
          )
      )
      (tray_init
          (:target industry_workbench)
          (:ranges (
              (-0.17957028378714865 -0.03199891514434636 -0.17956828378714865 -0.031996915144346355)
            )
          )
          (:yaw_rotation (
              (1.475821970145359 1.475821970145359)
            )
          )
      )
      (ghost_active_region
          (:target conveyor_ghost_1)
      )
      (goal_region
          (:target grey_plate_1)
      )
      (place_region_1
          (:target grey_plate_1)
      )
      (place_region_2
          (:target grey_plate_1)
      )
      (place_region_3
          (:target grey_plate_1)
      )
      (place_region_4
          (:target grey_plate_1)
      )
      (place_region_5
          (:target grey_plate_1)
      )
      (place_region_6
          (:target grey_plate_1)
      )
    )

  (:fixtures
    industry_workbench - industry_workbench
    conveyor_ghost_1 - conveyor_ghost
    grey_plate_1 - grey_plate
  )

  (:objects
    cream_bottle_flat_1 cream_bottle_flat_2 cream_bottle_flat_3 - cream_bottle_flat
    cream_jar_upright_1 - cream_jar_upright
    cream_jar_flat_1 - cream_jar_flat
  )

  (:obj_of_interest
  )

  (:init
    (On conveyor_ghost_1 industry_workbench_ghost_init)
    (On grey_plate_1 industry_workbench_tray_init)
    (LoadSlot conveyor_ghost_1 cream_bottle_flat_groove y pulse -0.0273 service_2.0)
    (On cream_bottle_flat_1 grey_plate_1_place_region_1)
    (On cream_bottle_flat_2 grey_plate_1_place_region_5)
    (On cream_bottle_flat_3 grey_plate_1_place_region_3)
    (On cream_jar_upright_1 grey_plate_1_place_region_6)
    (On cream_jar_flat_1 grey_plate_1_place_region_2)
  )

  (:goal
    (And (Routed cream_bottle_flat_1 conveyor_ghost_1) (Routed cream_bottle_flat_2 conveyor_ghost_1) (Routed cream_bottle_flat_3 conveyor_ghost_1))
  )

)
